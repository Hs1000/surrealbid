# ---------------- REQUIRED ----------------
# Random secret for signing login tokens (at least 32 characters). Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Bcrypt hash of the admin dashboard password. Generate one:
#   node -e "require('bcrypt').hash('your-admin-password', 12).then(console.log)"
ADMIN_PASSWORD_HASH=

# MongoDB connection string (local, or MongoDB Atlas in production)
MONGODB_URI=mongodb://127.0.0.1:27017/surrealbid

# ---------------- SERVER ----------------
PORT=3000
# Public URL of the site, used in email links. Required in production.
APP_URL=http://localhost:3000
# Set NODE_ENV=production when deployed (enables HSTS, strict config checks).
# NODE_ENV=production
# Behind a load balancer / reverse proxy (Render, Railway, Nginx…) set this to 1 so rate limits see real IPs.
# TRUST_PROXY=1
# Only needed if the API is called from a different domain (comma-separated).
# ALLOWED_ORIGINS=https://www.example.com
# Where uploaded images are stored (use a persistent disk in production).
# UPLOAD_DIR=/var/data/surrealbid-uploads

# ---------------- EMAIL (required in production) ----------------
# Any SMTP provider works: Resend, Postmark, Amazon SES, Brevo, Gmail SMTP…
# Without SMTP_HOST in development, emails (with their links) are printed to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SurrealBid <hello@yourdomain.com>
# Receives new-application, contact-form and payment notifications.
ADMIN_EMAIL=

# ---------------- PAYMENTS (Razorpay) ----------------
# From the Razorpay dashboard → Settings → API Keys. Use rzp_test_ keys until you're ready.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional but recommended: Settings → Webhooks → URL https://yourdomain.com/api/payments/webhook,
# events payment.captured and order.paid, with this secret.
RAZORPAY_WEBHOOK_SECRET=

# ---------------- MONITORING (optional) ----------------
# Error reporting with Sentry: set the DSN and run `npm install @sentry/node`.
# SENTRY_DSN=
